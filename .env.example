# Server
PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/slipflow.db

# Slip Reader Verification API (default: https://my-slip-reader.onrender.com)
SLIP_API_BASE_URL=https://my-slip-reader.onrender.com
SLIP_API_TIMEOUT_MS=65000

# LINE Official Account (Messaging API) — สามารถตั้งค่าผ่านหน้า Dashboard ได้เช่นกัน
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_NOTIFY_TARGET_ID=

# Facebook Page Messenger (Meta Webhooks) — สามารถตั้งค่าผ่านหน้า Dashboard ได้เช่นกัน
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=

# Optional: ตั้งรหัส API Key เริ่มต้นสำหรับ Chrome Extension (ถ้าเว้นว่าง ระบบจะสุ่มให้อัตโนมัติ)
EXTENSION_API_KEY=

# Optional: ตั้งรหัสผ่านสำหรับหน้า Dashboard เมื่อ Deploy ออนไลน์ (เว้นว่าง = ไม่ต้องล็อกอิน)
DASHBOARD_ACCESS_KEY=
